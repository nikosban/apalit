[gd_scene format=3]

[ext_resource type="Script" path="res://game/ui/ship_panel.gd" id="1_panel"]
[ext_resource type="PackedScene" path="res://game/ui/components/panel_shell.tscn" id="2_shell"]
[ext_resource type="PackedScene" path="res://game/ui/components/section.tscn" id="3_section"]
[ext_resource type="PackedScene" path="res://game/ui/transport_editor.tscn" id="4_editor"]

[node name="ShipPanel" type="CanvasLayer"]
script = ExtResource("1_panel")

[node name="Panel" parent="." instance=ExtResource("2_shell")]

[node name="ShipName" type="LineEdit" parent="Panel/Layout/Header"]
layout_mode = 2
tooltip_text = "Ship name (Enter to apply; empty restores the original name)"
theme_override_font_sizes/font_size = 18
placeholder_text = "Ship name"
max_length = 32
flat = true
select_all_on_focus = true

[node name="ShipClass" type="Label" parent="Panel/Layout/Header"]
layout_mode = 2
theme_type_variation = &"MutedLabel"

